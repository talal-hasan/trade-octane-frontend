<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the built Angular app.

  This lives in `public/` on purpose, so every build emits it alongside index.html and a
  deployment cannot forget to copy it. It is inert anywhere except IIS.

  The one rule that matters is the rewrite. Angular is a single-page app: the only real
  file on disk is index.html, and every route below it (`/admin/users/jdoe`) exists only
  in the browser's router. Without the rewrite, IIS looks for a folder named `admin` and
  returns 404 — so the app works until someone presses F5 or opens a shared link, which is
  the worst possible time to discover it.

  See DEPLOY-ON-VM.md for the hosting shape this assumes and for the prerequisites,
  notably the URL Rewrite module, which IIS does NOT install by default.
-->
<configuration>
  <system.webServer>

    <!--
      IIS refuses to serve extensions it has no MIME type for, answering 404. The Angular
      build emits .json (assets), .woff2 (fonts) and .webmanifest. IIS 10 knows .json and
      .woff2, but older images and hardened builds often do not, and a missing font shows
      up as a silently ugly page rather than an error.
    -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />

      <!--
        Seven days, not a year. The JS and CSS carry a content hash in their filename, so
        they could be cached forever — but `public/assets/*` (the logo) does not, and a
        logo that cannot be corrected for twelve months is a support ticket nobody can
        close. index.html is exempted below.
      -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <rewrite>
      <rules>
        <rule name="Angular deep links" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Anything that exists on disk is served as itself. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!--
              Never swallow API calls. Where the app is a sub-application (/portal), /api
              belongs to the parent site and this rule never sees it anyway — but if the
              app is ever moved to a site root with a reverse proxy for /api, this line is
              what stops a failed API call from being answered with the HTML of the app.
              A JSON client receiving `<!doctype html>` is a genuinely confusing failure.
            -->
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- Stops a browser from second-guessing a declared Content-Type. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- The portal is not meant to be embedded in another page. -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- Announcing the stack to the internet buys nothing. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>

  <!--
    index.html must never be cached.

    It is the file that names every hashed bundle. If a browser holds a stale copy, it
    keeps requesting the previous deployment's chunk filenames, which no longer exist, and
    the user gets a blank page after every release — the classic "it works after a hard
    refresh, so it must be their cache" bug. Making it uncacheable is what makes a
    redeploy take effect immediately.
  -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
